{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskHandoff checkpoint",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "source": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "enum": [
            "manual",
            "claude",
            "codex",
            "opencode",
            "copilot",
            "cursor",
            "import"
          ]
        },
        "sessionId": {
          "type": "string"
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "agent",
        "cwd"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "goal": {
          "$ref": "#/definitions/__schema0"
        },
        "acceptance": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema0"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "blocked",
            "done"
          ]
        }
      },
      "required": [
        "goal",
        "acceptance",
        "status"
      ],
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "properties": {
        "completed": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema0"
          }
        },
        "pending": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema0"
          }
        }
      },
      "required": [
        "completed",
        "pending"
      ],
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/__schema0"
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "approach": {
            "$ref": "#/definitions/__schema0"
          },
          "result": {
            "type": "string",
            "enum": [
              "failed",
              "rejected",
              "partial"
            ]
          },
          "reason": {
            "$ref": "#/definitions/__schema0"
          }
        },
        "required": [
          "approach",
          "result",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/__schema0"
      }
    },
    "nextAction": {
      "$ref": "#/definitions/__schema0"
    },
    "repository": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        },
        "statusHash": {
          "type": "string"
        },
        "changedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diffStat": {
          "type": "string"
        },
        "fileHashes": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "root",
        "branch",
        "head",
        "dirty",
        "statusHash",
        "changedFiles",
        "diffStat",
        "fileHashes"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exitCode": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "outputSummary": {
            "type": "string"
          },
          "provenance": {
            "default": "user-stated",
            "allOf": [
              {
                "$ref": "#/definitions/__schema1"
              }
            ]
          }
        },
        "required": [
          "command",
          "exitCode",
          "recordedAt",
          "outputSummary",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    "contextRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "symbols": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "default": "",
            "type": "string"
          },
          "hash": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "symbols",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "requiredTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredPermissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "requiredTools",
        "requiredPermissions"
      ],
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "properties": {
        "checkedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "stale": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "checkedAt",
        "stale",
        "reasons"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "taskId",
    "revision",
    "createdAt",
    "source",
    "task",
    "progress",
    "decisions",
    "attempts",
    "blockers",
    "nextAction",
    "repository",
    "verification",
    "contextRefs",
    "capabilities",
    "freshness"
  ],
  "additionalProperties": false,
  "definitions": {
    "__schema0": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/definitions/__schema1"
        },
        "evidence": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "text",
        "provenance",
        "evidence"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "enum": [
        "observed",
        "user-stated",
        "agent-inferred"
      ]
    }
  }
}
